# FAIDA Environment Configuration
# Copy this file or edit directly to configure your local and cloud providers

# --- Application Settings ---
FAIDA_PORT=8765
FAIDA_DEBUG=false

# --- Local Inference (Ollama) ---
# Primary model verified on your local system: gemma4:e4b
OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434

# --- Active Inference Provider ---
# Options: 'ollama' (Local Offline) or 'groq' (High-Speed Cloud)
FAIDA_PROVIDER=ollama

# --- Cloud LLM Providers (Optional for faster inference or low-power laptops) ---
# Groq Cloud API: Get a free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Optional Fallback): Get key at https://aistudio.google.com/
GEMINI_API_KEY=

# --- Future Scaling & Extended Market Feeds (Optional) ---
# FRED API (Free economic data from St. Louis Fed: Brent, US 10Y): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Pluggable Read-Only Broker Gateway (Optional: Upstox / Angel One / Dhan)
BROKER_API_KEY=
BROKER_NAME=upstox

# AlphaVantage free tier for global macro correlation: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# Finnhub free tier for global market sentiment: https://finnhub.io/
FINNHUB_API_KEY=

